# ============================================================
# Ambiente locale — tre file (tutti gitignored tranne questo esempio)
# ============================================================
#
# .env.local              → ambiente TEST — npm run dev, seed:*
# .env.production.local   → ambiente PROD  — npm run dev:prod
# .env.local.test         → TEST + E2E     — npm run test:e2e
#
# Template prod: copia .env.production.local.example → .env.production.local
# ============================================================

# --- .env.local (DB TEST — sviluppo quotidiano) ---
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key-here
TENANT_SLUG=your-test-tenant-slug

# --- .env.local.test (stesse VITE_* del test + Playwright / QA manuale) ---
# MANUAL_ADMIN_EMAIL=testp@p.com
# MANUAL_ADMIN_PASSWORD=...
# MANUAL_TENANT_SLUG=test-pro
# E2E_ADMIN_EMAIL / E2E_ADMIN_PASSWORD — stessi valori per Playwright
# E2E_CLASSIC_* — seed tenant classic (testc@c.com) se serve
